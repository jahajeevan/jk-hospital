NODE_ENV=production
PORT=5001
CLIENT_URL=https://hospital.example.com
CORS_ORIGINS=https://hospital.example.com,https://www.hospital.example.com
TRUST_PROXY=true
REQUEST_BODY_LIMIT=2mb

MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/jk-hospital?retryWrites=true&w=majority
JWT_SECRET=replace_with_at_least_64_random_characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=jkh_refresh

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=250
AUTH_RATE_LIMIT_MAX=20

AI_PROVIDER=ollama
OLLAMA_MODEL=gemma3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_MS=25000
OLLAMA_RETRIES=1

REDIS_URL=redis://127.0.0.1:6379
LOG_LEVEL=info
SENTRY_DSN=

EMAIL_USER=alerts@hospital.example.com
EMAIL_PASS=replace_with_app_password_or_smtp_secret

UPI_ID=replace_with_hospital_upi
CONSULTATION_FEE=500
STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=replace_with_live_key
RAZORPAY_KEY_SECRET=replace_with_live_secret
RAZORPAY_ALLOW_TEST_MODE=false
ALLOW_MANUAL_PAYMENT_PROOFS=false
